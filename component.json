{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "lib-vm-support",
  "kind": "library",
  "origin": {
    "repository": "https://github.com/roolrz/HypeR",
    "commit": "8d42d047058a2b58a291803700e86487fb723f7a"
  },
  "packages": [
    "hyper-vm-support",
    "hyper-vm-support-shared"
  ],
  "tests": [
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-vm-support"
    ]
  ],
  "cargo": [
    {
      "manifest": "Cargo.toml",
      "domain": "system"
    },
    {
      "manifest": "shared/Cargo.toml",
      "domain": "system"
    }
  ],
  "artifacts": [
    {
      "library": "libhyper_vm_support_shared.so",
      "staged": "lib/libhyper_vm_support_shared.so",
      "destination": "lib64/{arch}-hyper-hyper/libhyper_vm_support_shared.so",
      "mode": "0755",
      "profiles": [
        "system",
        "development",
        "io"
      ],
      "rust_runtime": "std",
      "environment": "system",
      "manifest": "shared/Cargo.toml"
    }
  ],
  "build": {
    "requires": [
      "toolchain"
    ],
    "actions": {
      "all": [
        [
          "python3",
          "{workspace}/scripts/build-native-module.py",
          "--module",
          "{module}",
          "--action",
          "{action}"
        ]
      ],
      "build": [
        [
          "python3",
          "{workspace}/scripts/build-native-module.py",
          "--module",
          "{module}",
          "--action",
          "{action}"
        ]
      ],
      "check": [
        [
          "python3",
          "{workspace}/scripts/build-native-module.py",
          "--module",
          "{module}",
          "--action",
          "{action}"
        ]
      ]
    }
  }
}
